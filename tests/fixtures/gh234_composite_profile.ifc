ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('gh234_composite_profile.ifc','2026-11-02T00:00:00',(''),(''),'hand-written','ifcfast GH #234','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPERSON($,'test','test',$,$,$,$,$);
#2=IFCORGANIZATION($,'','',$,$);
#3=IFCPERSONANDORGANIZATION(#1,#2,$);
#4=IFCORGANIZATION($,'ifcfast',$,$,$);
#5=IFCAPPLICATION(#4,'1','ifcfast','ifcfast');
#6=IFCOWNERHISTORY(#3,#5,$,.NOCHANGE.,$,$,$,1790781521);
#7=IFCCARTESIANPOINT((0.,0.,0.));
#8=IFCAXIS2PLACEMENT3D(#7,$,$);
#9=IFCDIRECTION((0.,1.));
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,0.01,#8,#9);
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#15=IFCUNITASSIGNMENT((#11,#12,#13,#14));
#16=IFCPROJECT('3Rk2cW9Nt1HfJ4sBpLgD0a',#6,'gh234',$,$,$,$,(#10),#15);
#17=IFCLOCALPLACEMENT($,#8);
#18=IFCBUILDINGSTOREY('3Rk2cW9Nt1HfJ4sBpLgD0b',#6,'Plan 01',$,$,#17,$,$,.ELEMENT.,0.);
#19=IFCRELAGGREGATES('3Rk2cW9Nt1HfJ4sBpLgD0c',#6,$,$,#16,(#18));
#20=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#21=IFCDIRECTION((0.,0.,1.));
#22=IFCLOCALPLACEMENT(#17,#8);
/* Wall A: composite of two disjoint members, the HI90_ARK_MMI700 shape
   (GH #234). Member 1: arbitrary closed triangle (0,0)-(1000,0)-(0,1000),
   0.5 m2. Member 2: 2000 x 200 rectangle whose own Position puts its
   centre at (3000,1000) rotated 90 deg -> x 2900..3100, y 0..2000, 0.4 m2.
   Depth 3000 mm -> analytic volume 0.9 m2 x 3 m = 2.7 m3. */
#30=IFCCARTESIANPOINT((0.,0.));
#31=IFCCARTESIANPOINT((1000.,0.));
#32=IFCCARTESIANPOINT((0.,1000.));
#33=IFCPOLYLINE((#30,#31,#32,#30));
#34=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'Component',#33);
#35=IFCCARTESIANPOINT((3000.,1000.));
#36=IFCDIRECTION((0.,1.));
#37=IFCAXIS2PLACEMENT2D(#35,#36);
#38=IFCRECTANGLEPROFILEDEF(.AREA.,'Component',#37,2000.,200.);
#39=IFCCOMPOSITEPROFILEDEF(.AREA.,'',(#34,#38),$);
#40=IFCEXTRUDEDAREASOLID(#39,#8,#21,3000.);
#41=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#40));
#42=IFCPRODUCTDEFINITIONSHAPE($,$,(#41));
#43=IFCWALL('3Rk2cW9Nt1HfJ4sBpLgD1a',#6,'composite wall',$,$,#22,#42,$,.NOTDEFINED.);
/* Wall B: composite whose members overlap -- two 1000 x 1000 squares
   centred at (500,500) and (1000,500). Union 1.5 m2, member sum 2.0 m2:
   the swept mesh counts the 0.5 m2 overlap twice (6.0 m3 vs 4.5 m3), so
   the row must be flagged profile_invalid='overlapping'. */
#50=IFCCARTESIANPOINT((500.,500.));
#51=IFCAXIS2PLACEMENT2D(#50,$);
#52=IFCRECTANGLEPROFILEDEF(.AREA.,'A',#51,1000.,1000.);
#53=IFCCARTESIANPOINT((1000.,500.));
#54=IFCAXIS2PLACEMENT2D(#53,$);
#55=IFCRECTANGLEPROFILEDEF(.AREA.,'B',#54,1000.,1000.);
#56=IFCCOMPOSITEPROFILEDEF(.AREA.,'',(#52,#55),$);
#57=IFCCARTESIANPOINT((0.,5000.,0.));
#58=IFCAXIS2PLACEMENT3D(#57,$,$);
#59=IFCEXTRUDEDAREASOLID(#56,#58,#21,3000.);
#60=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#59));
#61=IFCPRODUCTDEFINITIONSHAPE($,$,(#60));
#62=IFCWALL('3Rk2cW9Nt1HfJ4sBpLgD1b',#6,'overlapping composite wall',$,$,#22,#61,$,.NOTDEFINED.);
/* Wall C: composite with an unsupported member (IfcCenterLineProfileDef).
   The whole profile fails loudly (unhandled marker) instead of meshing
   only the supported member and under-reporting. */
#70=IFCCARTESIANPOINT((0.,0.));
#71=IFCCARTESIANPOINT((1000.,0.));
#72=IFCPOLYLINE((#70,#71));
#73=IFCCENTERLINEPROFILEDEF(.AREA.,'unsupported',#72,100.);
#74=IFCCOMPOSITEPROFILEDEF(.AREA.,'',(#34,#73),$);
#75=IFCCARTESIANPOINT((0.,10000.,0.));
#76=IFCAXIS2PLACEMENT3D(#75,$,$);
#77=IFCEXTRUDEDAREASOLID(#74,#76,#21,3000.);
#78=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#77));
#79=IFCPRODUCTDEFINITIONSHAPE($,$,(#78));
#80=IFCWALL('3Rk2cW9Nt1HfJ4sBpLgD1c',#6,'unsupported member wall',$,$,#22,#79,$,.NOTDEFINED.);
#90=IFCRELCONTAINEDINSPATIALSTRUCTURE('3Rk2cW9Nt1HfJ4sBpLgD0f',#6,$,$,(#43,#62,#80),#18);
ENDSEC;
END-ISO-10303-21;
