ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('gh220_crossing_sliver.ifc','2026-10-13T00:00:00',(''),(''),'hand-written','ifcfast GH #220','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPERSON($,'test','test',$,$,$,$,$);
#2=IFCORGANIZATION($,'','',$,$);
#3=IFCPERSONANDORGANIZATION(#1,#2,$);
#4=IFCORGANIZATION($,'ifcfast',$,$,$);
#5=IFCAPPLICATION(#4,'1','ifcfast','ifcfast');
#6=IFCOWNERHISTORY(#3,#5,$,.NOCHANGE.,$,$,$,1790781521);
#7=IFCCARTESIANPOINT((0.,0.,0.));
#8=IFCAXIS2PLACEMENT3D(#7,$,$);
#9=IFCDIRECTION((0.,1.));
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,0.01,#8,#9);
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#15=IFCUNITASSIGNMENT((#11,#12,#13,#14));
#16=IFCPROJECT('2Qm8aZ7Lr0ZeH1rAqKfC9a',#6,'gh220',$,$,$,$,(#10),#15);
#17=IFCLOCALPLACEMENT($,#8);
#18=IFCBUILDINGSTOREY('2Qm8aZ7Lr0ZeH1rAqKfC9b',#6,'Plan 01',$,$,#17,$,$,.ELEMENT.,0.);
#19=IFCRELAGGREGATES('2Qm8aZ7Lr0ZeH1rAqKfC9c',#6,$,$,#16,(#18));
#20=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#21=IFCDIRECTION((0.,0.,1.));
/* Sliver wall: an authored arc (0,0)->(3000,300)->(6000,0) closed by a
   polyline (6000,0)->(4000,600)->(2000,-100)->(0,0) whose middle edge
   crosses the arc. A self-intersecting profile as authored (GH #220). */
#30=IFCCARTESIANPOINTLIST2D(((0.,0.),(3000.,300.),(6000.,0.),(4000.,600.),(2000.,-100.)),$);
#31=IFCINDEXEDPOLYCURVE(#30,(IFCARCINDEX((1,2,3)),IFCLINEINDEX((3,4,5,1))),.F.);
#32=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'crossing sliver',#31);
#33=IFCEXTRUDEDAREASOLID(#32,#8,#21,3000.);
#34=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#33));
#35=IFCPRODUCTDEFINITIONSHAPE($,$,(#34));
#36=IFCLOCALPLACEMENT(#17,#8);
#37=IFCWALL('2Qm8aZ7Lr0ZeH1rAqKfC9d',#6,'crossing sliver wall',$,$,#36,#35,$,.NOTDEFINED.);
/* Control: the same arc closed by a straight chord -- a valid segment. */
#40=IFCCARTESIANPOINTLIST2D(((0.,0.),(3000.,300.),(6000.,0.)),$);
#41=IFCINDEXEDPOLYCURVE(#40,(IFCARCINDEX((1,2,3)),IFCLINEINDEX((3,1))),.F.);
#42=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'valid segment',#41);
#43=IFCCARTESIANPOINT((0.,5000.,0.));
#44=IFCAXIS2PLACEMENT3D(#43,$,$);
#45=IFCEXTRUDEDAREASOLID(#42,#44,#21,3000.);
#46=IFCSHAPEREPRESENTATION(#20,'Body','SweptSolid',(#45));
#47=IFCPRODUCTDEFINITIONSHAPE($,$,(#46));
#48=IFCWALL('2Qm8aZ7Lr0ZeH1rAqKfC9e',#6,'valid segment wall',$,$,#36,#47,$,.NOTDEFINED.);
#50=IFCRELCONTAINEDINSPATIALSTRUCTURE('2Qm8aZ7Lr0ZeH1rAqKfC9f',#6,$,$,(#37,#48),#18);
ENDSEC;
END-ISO-10303-21;
