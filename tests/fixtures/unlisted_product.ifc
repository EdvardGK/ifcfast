ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('unlisted_product.ifc','2026-09-17T00:00:00',(''),(''),'ifcfast GH #178','ifcfast GH #178','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('2Unl178Project00000000',$,'Unlisted Product 178',$,$,$,$,(#10),#5);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#4=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#5=IFCUNITASSIGNMENT((#4,#2,#3));
#6=IFCCARTESIANPOINT((0.,0.,0.));
#7=IFCDIRECTION((0.,0.,1.));
#8=IFCDIRECTION((1.,0.,0.));
#9=IFCAXIS2PLACEMENT3D(#6,#7,#8);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.0000000000000001E-05,#9,$);
#11=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#12=IFCSITE('2Unl178Site00000000000',$,'Site',$,$,#31,$,$,$,$,$,$,$,$);
#13=IFCBUILDING('2Unl178Building0000000',$,'Building',$,$,#31,$,$,$,$,$,$);
#14=IFCBUILDINGSTOREY('2Unl178Storey000000000',$,'Level 0',$,$,#31,$,$,$,$);
#15=IFCRELAGGREGATES('2Unl178Agg100000000000',$,$,$,#1,(#12));
#16=IFCRELAGGREGATES('2Unl178Agg200000000000',$,$,$,#12,(#13));
#17=IFCRELAGGREGATES('2Unl178Agg300000000000',$,$,$,#13,(#14));
#18=IFCTUBEBUNDLE('2Unl178Elem00000000000',$,'Tube bundle',$,$,#31,#29,'TB-01',.NOTDEFINED.);
#19=IFCCARTESIANPOINT((0.,0.));
#20=IFCAXIS2PLACEMENT2D(#19,$);
#21=IFCRECTANGLEPROFILEDEF(.AREA.,$,#20,2.,3.);
#22=IFCCARTESIANPOINT((0.,0.,0.));
#23=IFCDIRECTION((0.,0.,1.));
#24=IFCDIRECTION((1.,0.,0.));
#25=IFCAXIS2PLACEMENT3D(#22,#23,#24);
#26=IFCDIRECTION((0.,0.,1.));
#27=IFCEXTRUDEDAREASOLID(#21,#25,#26,4.);
#28=IFCSHAPEREPRESENTATION(#11,'Body','SweptSolid',(#27));
#29=IFCPRODUCTDEFINITIONSHAPE($,$,(#28));
#30=IFCRELCONTAINEDINSPATIALSTRUCTURE('2Unl178Contain00000000',$,$,$,(#18),#14);
#31=IFCLOCALPLACEMENT($,#9);
/* GH #178 (review): relationships that carry a reference-or-`$` at
   attributes 5 and 6 — exactly the IfcProduct attribute shape the
   skipped-product probe keys on. Without these records the
   "relationships are not mistaken for products" test passes vacuously,
   because every relationship above is one the indexer dispatches by
   name. The refs are deliberately loose — every candidate referent (an
   IfcSpace, an IfcPort pair) is itself an indexed product and would
   destroy this fixture's zero-product premise. The probe reads
   attribute SHAPE only; it never resolves a reference. */
#32=IFCGROUP('2Unl178Group0000000000',$,'Group',$,$);
#33=IFCRELASSIGNSTOGROUP('2Unl178RelAssign000000',$,$,$,(#18),$,#32);
#34=IFCRELCONNECTSPATHELEMENTS('2Unl178RelPath00000000',$,$,$,$,#18,#18,(),(),.ATSTART.,.ATEND.);
#35=IFCRELSPACEBOUNDARY('2Unl178RelBound0000000',$,$,$,#18,#18,$,.PHYSICAL.,.EXTERNAL.);
#36=IFCRELCONNECTSPORTS('2Unl178RelPorts0000000',$,$,$,#18,#18,$);
ENDSEC;
END-ISO-10303-21;
