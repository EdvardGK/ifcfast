ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('duplicate_pset_names.ifc','2026-09-29T00:00:00',(''),(''),'ifcfast','ifcfast','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0000000000000000000001',$,'P',$,$,$,$,$,$);
#2=IFCWALL('0000000000000000000002',$,'A',$,$,$,$,$,.SOLIDWALL.);
#3=IFCWALL('0000000000000000000003',$,'B',$,$,$,$,$,.SOLIDWALL.);
#4=IFCWALL('0000000000000000000004',$,'C',$,$,$,$,$,.SOLIDWALL.);
#10=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.T.),$);
#11=IFCPROPERTYSINGLEVALUE('FireRating',$,IFCLABEL('EI60'),$);
#12=IFCPROPERTYSINGLEVALUE('FireRating',$,IFCLABEL('EI30'),$);
#20=IFCPROPERTYSET('0000000000000000000020',$,'Pset_WallCommon',$,(#10));
#21=IFCPROPERTYSET('0000000000000000000021',$,'Pset_WallCommon',$,(#11));
#22=IFCPROPERTYSET('0000000000000000000022',$,'Pset_WallCommon',$,(#12));
#23=IFCPROPERTYSET('0000000000000000000023',$,'Pset_WallCommon',$,(#10));
#24=IFCPROPERTYSET('0000000000000000000024',$,'Pset_WallCommon',$,(#12));
#25=IFCPROPERTYSET('0000000000000000000025',$,'Pset_WallCommon',$,(#11));
/* wall A: FireRating only in the second set */
#30=IFCRELDEFINESBYPROPERTIES('0000000000000000000030',$,$,$,(#2),#20);
#31=IFCRELDEFINESBYPROPERTIES('0000000000000000000031',$,$,$,(#2),#21);
/* wall B: FireRating only in the first set */
#32=IFCRELDEFINESBYPROPERTIES('0000000000000000000032',$,$,$,(#3),#22);
#33=IFCRELDEFINESBYPROPERTIES('0000000000000000000033',$,$,$,(#3),#23);
/* wall C: FireRating in both sets, EI30 first then EI60 */
#34=IFCRELDEFINESBYPROPERTIES('0000000000000000000034',$,$,$,(#4),#24);
#35=IFCRELDEFINESBYPROPERTIES('0000000000000000000035',$,$,$,(#4),#25);
ENDSEC;
END-ISO-10303-21;
